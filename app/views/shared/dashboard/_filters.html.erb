<div class="bg-white rounded-lg shadow-md p-6 mb-6">
  <%= form_with url: url, method: :get, local: true do %>
    <div class="flex flex-col md:flex-row md:items-end gap-4">
      <% if search %>
        <div class="flex-1">
          <%= label_tag :search, search[:label], class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= text_field_tag :search, params[:search], 
              placeholder: search[:placeholder], 
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500" %>
        </div>
      <% end %>
      
      <% filters&.each do |filter| %>
        <div class="flex-1">
          <%= label_tag filter[:name], filter[:label], class: "block text-sm font-medium text-gray-700 mb-2" %>
          <%= select_tag filter[:name], 
              options_for_select(filter[:options], params[filter[:name]]),
              class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-yellow-500" %>
        </div>
      <% end %>
      
      <div class="flex gap-3">
        <%= button_tag "Apply", type: "submit", class: "px-6 py-2 bg-yellow-500 hover:bg-yellow-600 text-white font-semibold rounded-lg whitespace-nowrap" %>
        <%= link_to "Clear", url, class: "px-6 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold rounded-lg whitespace-nowrap" %>
      </div>
    </div>
  <% end %>
</div>