<div class="flex justify-center items-center gap-2 mt-6">
  <% if @pagination[:current_page] > 1 %>
    <%= link_to "<<", instruments_path(page: 1), 
        class: "px-3 py-2 bg-yellow-500 text-white rounded hover:bg-yellow-600" %>
    <%= link_to "<", instruments_path(page: @pagination[:current_page] - 1), 
        class: "px-3 py-2 bg-yellow-500 text-white rounded hover:bg-yellow-600" %>
  <% end %>

  <% (1..@pagination[:total_pages]).each do |page| %>
    <% if page == @pagination[:current_page] %>
      <span class="px-3 py-2 bg-gray-400 text-white rounded">
        <%= page %>
      </span>
    <% else %>
      <%= link_to page, instruments_path(page: page), 
          class: "px-3 py-2 bg-gray-200 text-gray-700 rounded hover:bg-gray-300" %>
    <% end %>
  <% end %>

  <% if @pagination[:current_page] < @pagination[:total_pages] %>
    <%= link_to ">", instruments_path(page: @pagination[:current_page] + 1), 
        class: "px-3 py-2 bg-yellow-500 text-white rounded hover:bg-yellow-600" %>
    <%= link_to ">>", instruments_path(page: @pagination[:total_pages]), 
        class: "px-3 py-2 bg-yellow-500 text-white rounded hover:bg-yellow-600" %>
  <% end %>
</div>