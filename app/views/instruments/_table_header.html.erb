<%
  current_column = params.dig(:order, :column).presence || "created_at"
  current_direction = params.dig(:order, :direction).presence || "desc"
%>

<thead class="bg-gradient-to-r from-yellow-400 to-yellow-500">
  <tr>
    <th scope="col" class="w-1/6 px-6 py-4 text-left text-sm font-bold text-white uppercase tracking-wider">
      <%= link_to instruments_path(order: { column: "ticker", direction: current_column == "ticker" && current_direction == "asc" ? "desc" : "asc" }),
                  class: "flex items-center gap-2 hover:opacity-80 transition-opacity" do %>
        Ticker
        <% if current_column == "ticker" %>
          <%= icon(current_direction == "asc" ? "arrow_down" : "arrow_up") %>
        <% end %>
      <% end %>
    </th>

    <th scope="col" class="w-2/6 px-6 py-4 text-left text-sm font-bold text-white uppercase tracking-wider">
      <%= link_to instruments_path(order: { column: "name", direction: current_column == "name" && current_direction == "asc" ? "desc" : "asc" }),
                  class: "flex items-center gap-2 hover:opacity-80 transition-opacity" do %>
        Name
        <% if current_column == "name" %>
          <%= icon(current_direction == "asc" ? "arrow_down" : "arrow_up") %>
        <% end %>
      <% end %>
    </th>

    <th scope="col" class="w-1/6 px-6 py-4 text-left text-sm font-bold text-white uppercase tracking-wider">
      <%= link_to instruments_path(order: { column: "kind", direction: current_column == "kind" && current_direction == "asc" ? "desc" : "asc" }),
                  class: "flex items-center gap-2 hover:opacity-80 transition-opacity" do %>
        Type
        <% if current_column == "kind" %>
          <%= icon(current_direction == "asc" ? "arrow_down" : "arrow_up") %>
        <% end %>
      <% end %>
    </th>

    <th scope="col" class="w-1/6 px-6 py-4 text-left text-sm font-bold text-white uppercase tracking-wider">
      <%= link_to instruments_path(order: { column: "created_at", direction: current_column == "created_at" && current_direction == "asc" ? "desc" : "asc" }),
                  class: "flex items-center gap-2 hover:opacity-80 transition-opacity" do %>
        Created At
        <% if current_column == "created_at" %>
          <%= icon(current_direction == "asc" ? "arrow_down" : "arrow_up") %>
        <% end %>
      <% end %>
    </th>

    <th scope="col" class="w-1/6 px-6 py-4 text-center text-sm font-bold text-white uppercase tracking-wider">
      Actions
    </th>
  </tr>
</thead>